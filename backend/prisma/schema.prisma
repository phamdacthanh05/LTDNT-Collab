// Đang cấu hình cho MySQL (dùng chung với phpMyAdmin qua Laragon/XAMPP).
// Nếu sau này muốn đổi qua PostgreSQL thì đổi "provider" thành "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // đổi thành "postgresql" nếu bạn muốn dùng PostgreSQL thay vì MySQL
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING // chờ thanh toán
  PAID // đã thanh toán, chờ giao
  DELIVERED // đã giao hàng (đã gửi tool/tài khoản cho khách)
  CANCELLED // đã huỷ
}

enum PaymentMethod {
  MOMO // dùng để NẠP TIỀN vào ví (qua MoMo)
  WALLET // MỚI: thanh toán đơn hàng bằng số dư ví
}

// MỚI: loại giao dịch trong ví
enum WalletTxType {
  TOPUP // nạp tiền vào ví qua MoMo (+)
  PURCHASE // trừ tiền khi mua hàng (-)
  REFUND // hoàn tiền (+)
}

enum WalletTxStatus {
  PENDING // đang chờ MoMo xác nhận (chỉ áp dụng cho TOPUP)
  SUCCESS
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ====== Mở rộng: phân quyền ADMIN duy nhất / BUYER (khách mua) ======
// Enum MỚI HOÀN TOÀN — dùng cho cột `role` thêm vào User bên dưới.
enum UserRole {
  ADMIN // chỉ 1 tài khoản chủ shop trong toàn hệ thống
  BUYER // mặc định cho tất cả tài khoản khách hàng
}

model User {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  passwordHash  String
  address       String?  @db.Text // địa chỉ giao hàng — cột mới, không ảnh hưởng dữ liệu cũ
  role          UserRole @default(BUYER) // cột mới: phân biệt ADMIN (chủ shop) và BUYER (khách mua)
  walletBalance Decimal  @default(0) @db.Decimal(12, 0) // số dư ví, đơn vị VNĐ — CHỈ có ý nghĩa với BUYER. ADMIN không có số dư (tiền nằm trong MoMo của chủ shop)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  conversations Conversation[] // các cuộc trò chuyện mà user này là người mua
  sentMessages  Message[] // các tin nhắn user này đã gửi (khi senderRole = USER)
  purchases     PurchaseHistory[] // MỚI: lịch sử mua hàng (tài khoản/mật khẩu đã mua)
  walletTransactions WalletTransaction[] // MỚI: lịch sử nạp tiền / trừ tiền ví

  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 0) // VNĐ, không thập phân
  category    String? // vd: "Canva Pro", "Tool", "Tài khoản"
  imageUrl    String?
  stock       Int      @default(0) // số lượng còn lại — luôn được đồng bộ = số dòng trong product_accounts
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems    OrderItem[]
  conversations Conversation[] // các cuộc trò chuyện hỏi về sản phẩm này (tuỳ chọn)
  accounts      ProductAccount[] // MỚI: kho tài khoản của sản phẩm (mỗi dòng = 1 tài khoản bán được 1 lần)

  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Decimal     @db.Decimal(12, 0)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items         OrderItem[]
  payment       Payment?
  conversations Conversation[] // các cuộc trò chuyện hỏi về đơn hàng này (tuỳ chọn)
  purchases     PurchaseHistory[] // MỚI: các tài khoản đã giao cho đơn hàng này
  walletTransactions WalletTransaction[] // MỚI: giao dịch trừ ví của đơn hàng này

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 0) // giá tại thời điểm mua (đề phòng giá sau đổi)

  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String? // mã giao dịch bên Momo trả về
  rawResponse   String?       @db.LongText // JSON.stringify của response/IPN để đối soát (dùng LongText cho tương thích MariaDB)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// ====== MỚI: Ví tiền của khách ======
// Mỗi dòng = 1 lần nạp (TOPUP) hoặc 1 lần trừ tiền khi mua (PURCHASE).
// Số dư thật nằm ở users.walletBalance; bảng này là sổ giao dịch để đối soát.
// Với TOPUP: id của dòng này chính là mã đơn gửi sang MoMo (có tiền tố "TOPUP_").
model WalletTransaction {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  type          WalletTxType
  status        WalletTxStatus @default(PENDING)
  amount        Decimal        @db.Decimal(12, 0) // luôn dương; type quyết định cộng hay trừ
  balanceAfter  Decimal?       @db.Decimal(12, 0) // số dư sau giao dịch (chỉ có khi SUCCESS)
  orderId       String? // có giá trị khi type = PURCHASE
  order         Order?         @relation(fields: [orderId], references: [id])
  description   String?
  transactionId String? // mã giao dịch phía MoMo (transId)
  rawResponse   String?        @db.LongText
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([orderId])
  @@map("wallet_transactions")
}

// ====== MỚI: Kho tài khoản & Lịch sử mua hàng ======
// Mỗi sản phẩm có thể có hàng chục/hàng trăm nghìn tài khoản (vd CapCut Pro).
// Khi khách mua: lấy ra N dòng, XOÁ khỏi bảng này, rồi chép sang PurchaseHistory.
model ProductAccount {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  username  String // tài khoản (email / username)
  password  String // mật khẩu của tài khoản đó (lưu nguyên văn vì phải giao cho khách)
  note      String? // ghi chú thêm (vd: hạn dùng, link đăng nhập) — tuỳ chọn
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_accounts")
}

// Bản sao tài khoản đã bán, hiển thị cho khách ở "Lịch sử mua hàng".
// Tự động bị xoá sau 7 ngày (expiresAt) — xem src/utils/cleanup.js
model PurchaseHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id])
  productId       String // không FK để vẫn giữ lịch sử nếu sản phẩm bị xoá
  productName     String // chụp lại tên sản phẩm tại thời điểm mua
  accountUsername String
  accountPassword String
  accountNote     String?
  unitPrice       Decimal  @db.Decimal(12, 0)
  purchasedAt     DateTime @default(now())
  expiresAt       DateTime // = purchasedAt + 7 ngày, quá hạn sẽ bị xoá

  @@index([userId])
  @@index([orderId])
  @@index([expiresAt])
  @@map("purchase_history")
}

// ====== Mở rộng: Tin nhắn trong app (In-app Messaging) ======
// Model MỚI HOÀN TOÀN, không đụng tới các model phía trên.

enum MessageSenderRole {
  USER // người mua gửi (lấy danh tính qua token đăng nhập)
  ADMIN // shop/admin trả lời (xác thực bằng ADMIN_SECRET, xem chat.routes.js)
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  subject   String? // tiêu đề ngắn hiển thị trong danh sách hội thoại
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // cập nhật mỗi khi có tin nhắn mới, dùng để sắp xếp danh sách

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  senderRole     MessageSenderRole
  senderUserId   String? // chỉ có giá trị khi senderRole = USER
  senderUser     User?             @relation(fields: [senderUserId], references: [id])
  content        String            @db.Text
  isRead         Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@map("messages")
}
