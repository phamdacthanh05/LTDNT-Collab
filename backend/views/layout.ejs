<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Digital Store</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <aside class="sidebar">
            <div class="logo">
                <span class="logo-icon">⚡</span>
                <span>Digital Admin</span>
            </div>
            <nav>
                <a href="/admin/dashboard" class="nav-link">📊 Tổng quan</a>
                <a href="/admin/products" class="nav-link">🛍️ Sản phẩm</a>
                <a href="/admin/products/accounts" class="nav-link">📦 Kho tài khoản</a>
                <a href="/admin/orders" class="nav-link">🧾 Đơn hàng</a>
                <a href="/admin/users" class="nav-link">👥 Người dùng</a>
                <a href="/admin/wallet" class="nav-link">💳 Giao dịch ví</a>
                <a href="/admin/support" class="nav-link">💬 Hỗ trợ Chat</a>
                <a href="/admin/logout" class="nav-link logout">🚪 Đăng xuất</a>
            </nav>
        </aside>
        <main class="content">
            <header class="page-header">
                <h1><%= title %></h1>
            </header>
            <div class="body">
                <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>
                <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>
                <%- body %>
            </div>
        </main>
    </div>

    <!-- Script nhỏ để gán chiều cao cột cho biểu đồ (thay vì inline style trong EJS) -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.bar[data-height]').forEach(function (el) {
                var h = el.getAttribute('data-height');
                if (h) el.style.height = h + '%';
            });
        });
    </script>
</body>
</html>