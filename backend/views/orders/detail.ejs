<a href="/admin/orders" class="btn-secondary" style="margin-bottom: 20px;">← Quay lại danh sách</a>

<!-- ============ ORDER INFO ============ -->
<div class="card">
    <div class="order-header">
        <div>
            <h2>Đơn hàng <code>#<%= order.id.slice(0, 8) %></code></h2>
            <p class="text-muted">Ngày tạo: <%= new Date(order.createdAt).toLocaleString('vi-VN') %></p>
        </div>
        <span class="badge badge-lg badge-<%= order.status === 'DELIVERED' ? 'success' : (order.status === 'PAID' ? 'info' : (order.status === 'PENDING' ? 'warning' : 'danger')) %>">
            <%= order.status %>
        </span>
    </div>
</div>

<div class="dashboard-2col">
    <!-- Khách hàng -->
    <div class="card">
        <h3 class="card-title">👤 Khách hàng</h3>
        <div class="info-row"><strong>Họ tên:</strong> <%= order.user.fullName %></div>
        <div class="info-row"><strong>Email:</strong> <%= order.user.email %></div>
        <div class="info-row"><strong>Số dư ví:</strong> <%= new Intl.NumberFormat('vi-VN').format(order.user.walletBalance) %> đ</div>
        <a href="/admin/users/<%= order.user.id %>" class="btn-sm" style="margin-top: 12px;">Xem hồ sơ khách →</a>
    </div>

    <!-- Thanh toán -->
    <div class="card">
        <h3 class="card-title">💳 Thanh toán</h3>
        <div class="info-row"><strong>Phương thức:</strong> <%= order.payment?.method || 'Chưa có' %></div>
        <div class="info-row"><strong>Trạng thái:</strong>
            <span class="badge badge-<%= order.payment?.status === 'SUCCESS' ? 'success' : (order.payment?.status === 'PENDING' ? 'warning' : 'danger') %>">
                <%= order.payment?.status || 'N/A' %>
            </span>
        </div>
        <div class="info-row"><strong>Mã giao dịch:</strong> <%= order.payment?.transactionId || '-' %></div>
        <div class="info-row"><strong>Tổng tiền:</strong> <span class="text-primary" style="font-size: 20px; font-weight: bold;"><%= new Intl.NumberFormat('vi-VN').format(order.totalAmount) %> đ</span></div>
    </div>
</div>

<!-- ============ ORDER ITEMS ============ -->
<div class="card">
    <h3 class="card-title">🛍️ Sản phẩm trong đơn</h3>
    <table class="admin-table">
        <thead>
            <tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr>
        </thead>
        <tbody>
            <% order.items.forEach(i => { %>
                <tr>
                    <td><strong><%= i.product.name %></strong></td>
                    <td><%= new Intl.NumberFormat('vi-VN').format(i.unitPrice) %> đ</td>
                    <td><%= i.quantity %></td>
                    <td><strong><%= new Intl.NumberFormat('vi-VN').format(i.unitPrice * i.quantity) %> đ</strong></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- ============ TÀI KHOẢN ĐÃ GIAO ============ -->
<% if (purchaseHistory.length > 0) { %>
    <div class="card">
        <h3 class="card-title">🎫 Tài khoản đã giao cho khách</h3>
        <table class="admin-table">
            <thead>
                <tr><th>Sản phẩm</th><th>Tài khoản</th><th>Mật khẩu</th><th>Ghi chú</th><th>Hết hạn</th></tr>
            </thead>
            <tbody>
                <% purchaseHistory.forEach(p => { %>
                    <tr>
                        <td><strong><%= p.productName %></strong></td>
                        <td><code><%= p.accountUsername %></code></td>
                        <td><code><%= p.accountPassword %></code></td>
                        <td><small><%= p.accountNote || '-' %></small></td>
                        <td><small><%= new Date(p.expiresAt).toLocaleString('vi-VN') %></small></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

<!-- ============ CẬP NHẬT TRẠNG THÁI ============ -->
<div class="card">
    <h3 class="card-title">⚙️ Cập nhật trạng thái</h3>
    <% if (['DELIVERED', 'CANCELLED'].includes(order.status)) { %>
        <p class="text-muted">Đơn hàng đã <%= order.status === 'DELIVERED' ? 'giao' : 'hủy' %>, không thể thay đổi trạng thái.</p>
    <% } else { %>
        <form action="/admin/orders/<%= order.id %>/status" method="POST" class="filter-form" onsubmit="return confirm('Xác nhận đổi trạng thái?');">
            <select name="status" required>
                <option value="PENDING" <%= order.status === 'PENDING' ? 'selected' : '' %>>⏳ Chờ xử lý (PENDING)</option>
                <option value="PAID" <%= order.status === 'PAID' ? 'selected' : '' %>>💳 Đã thanh toán (PAID)</option>
                <option value="DELIVERED" <%= order.status === 'DELIVERED' ? 'selected' : '' %>>✅ Đã giao (DELIVERED)</option>
                <option value="CANCELLED" <%= order.status === 'CANCELLED' ? 'selected' : '' %>>❌ Hủy (CANCELLED)</option>
            </select>
            <button type="submit" class="btn-primary">CẬP NHẬT</button>
        </form>
    <% } %>
</div>