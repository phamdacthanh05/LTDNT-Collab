<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
    <div class="login-box">
        <h2>⚡ Admin Login</h2>
        <p class="login-subtitle">Digital Store Management</p>
        <% if (error && error.length > 0) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="admin@example.com" required autofocus>
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn-primary btn-block">Đăng nhập</button>
        </form>
        <p class="login-note">Chỉ tài khoản có quyền ADMIN mới truy cập được.</p>
    </div>
</body>
</html>